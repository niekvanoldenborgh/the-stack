# Copy to .env (or set these however the host injects env vars) and fill in.
# See README.md "Running the API" / "What a real deploy needs" for details.

# --- Database (same names scripts/migrate.mjs already reads) ---
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- Auth API ---
# Secret used to sign/verify access-token JWTs. Required; the process
# refuses to boot without it. Generate with e.g. `openssl rand -hex 32`.
JWT_SECRET=

# Server-side pepper for sessions.ip_hash (HMAC-SHA256(ip, pepper)).
# Optional — without it, sessions are stored with a null ip_hash rather than
# an unsalted (brute-forceable) digest. Generate with `openssl rand -hex 32`.
SESSION_IP_PEPPER=

# Privacy-policy/ToS version stamped on new consent rows. Coordinate with
# whatever THEA-91/THEA-93 version their document as.
TOS_POLICY_VERSION=unversioned

# Port the HTTP server listens on.
PORT=3001
