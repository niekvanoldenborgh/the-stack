# Template for the secrets the GitHub Actions pipeline needs.
#
# Copy to `.env.ci` (gitignored), fill in real values, then push them into
# GitHub Secrets in one command:
#
#   gh secret set -f .env.ci
#
# These must NOT be committed. This repository is PUBLIC: anything committed
# here is world-readable, and stays in git history even after deletion.
#
#   EXPO_TOKEN        — expo.dev/settings/access-tokens. Grants building and
#                       publishing under your Expo account, and reaches the
#                       Android keystore.
#   N8N_WEBHOOK_URL   — your n8n Production webhook. This is a capability, not
#                       just an address: whoever holds it can trigger the flow.

EXPO_TOKEN=
N8N_WEBHOOK_URL=
