# Telegram bridge config — copy to `.env` in this same directory and fill in.
# `.env` is gitignored (never committed); this template is committed.
# Node 22+ has global fetch, so no `npm install` is needed to run the bridge.

# --- Telegram ---
# Regenerated via BotFather (the old token was pasted in plaintext once and
# must not be reused as-is). No angle brackets, no quotes.
TELEGRAM_BOT_TOKEN=123456789:AA...replace-me
# The "paperclip - the stack" group. Negative for group chats — keep the minus.
TELEGRAM_CHAT_ID=-5399152677

# --- Paperclip API ---
PAPERCLIP_API_URL=https://paper.nfpassistance.tech
PAPERCLIP_COMPANY_ID=b4283a58-c34f-405e-9261-02be9cf6cfc2
# Durable agent API key minted ONCE from the dashboard (Agents > API Keys).
# NOT a run-scoped runtime token — those expire in ~1h and will silently
# stop the bridge. Paste the durable key here.
PAPERCLIP_API_KEY=replace-me

# --- Optional ---
# Real dashboard origin so notification links open the issue page, not JSON.
# PAPERCLIP_APP_BASE_URL=https://paper.nfpassistance.tech
# Identifies this poller for the single-consumer guard (defaults to hostname:pid).
# TELEGRAM_BRIDGE_INSTANCE_ID=vps-cron
